<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/product.css">
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

    <main>
        <!-- 🔥 Add this block -->
        <section style="text-align:center; margin: 20px;">
            <h1>Welcome to Artechworld</h1>
            <p>Click on ARtechworld to check the portfolio and click on contact to get in touch 🚀</p><br>
            <p>DevOps-focused System Administrator with 5+ years of experience in infrastructure management, cloud platforms, and automation. Over the past 2 years, I have been actively working on CI/CD pipelines, containerized deployments, monitoring solutions, and AWS-based environments through hands-on implementation and real-world projects.</p>

<p>I enjoy building reliable systems, automating repetitive tasks, improving deployment workflows, and working with modern DevOps tools including Docker, Kubernetes, GitHub Actions, Grafana, and Prometheus.</p>

<p>My experience includes Linux administration, web hosting, firewall/security management, cloud infrastructure, and monitoring solutions across development and production environments.</p>
        </section>

        <% if (prods.length > 0) { %>
            <div class="grid">
                <% for (let product of prods) { %>
                    <article class="card product-item">
                        <header class="card__header">
                            <h1 class="product__title"><%= product.title %></h1>
                        </header>
                        <div class="card__image">
                            <img src="<%= product.imageUrl %>"
                                alt="<%= product.title %>">
                        </div>
                        <div class="card__content">
                            <h2 class="product__price">$<%= product.price %></h2>
                            <p class="product__description"><%= product.description %></p>
                        </div>
                        <div class="card__actions">
                            <%- include('../includes/add-to-cart.ejs',  {product: product})  %>
                        </div>
                    </article>
                <% } %>
            </div>
        <% } else { %>
            <h1>No Products Found!</h1>
        <% } %>
    </main>
<%- include('../includes/end.ejs') %>